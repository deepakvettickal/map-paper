rules_version = '2';

// Nothing reaches this database from a browser. Telemetry is written by the
// Cloudflare Pages Function in functions/api/event.ts, which authenticates with a
// service account; service accounts bypass these rules through the Admin API.
// Reading is done from the console or a trusted script, never from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
