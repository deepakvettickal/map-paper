    "vignette": 0.1
  },
  "patterns": {
    "green": {
      "type": "dots",
      "color": "#76a060",
      "bg": "#8BB174",
      "spacing": 7,
      "width": 0.7
    },
    "forest": {
      "type": "dots",
      "color": "#55a45b",
      "bg": "#64B96A",
      "spacing": 7,
      "width": 0.7
    }
  },
  "labels": {
    "uppercase": true,
    "letterSpacing": 0.25,
    "scale": 0.85
  }
