{
  "id": "heerhugowaard",
  "name": "Heerhugowaard",
  "credit": "Tribute to prettymaps by Marcelo Prates",
  "colors": {
    "land": "#F2F4CB",
    "water": "#A8E1E6",
    "waterDots": "#8FCBD2",
    "green": "#8BB174",
    "forest": "#64B96A",
    "sand": "#F2E3A6",
    "buildings": [
      "#433633",
      "#FF5E5B",
      "#433633",
      "#FF5E5B",
      "#FF5E5B"
    ],
    "outline": "#2F3737",
    "road": "#2F3737",
    "roadCasing": "#2F3737",
    "rail": "#2F3737",
    "frame": "#FFFFFF",
    "text": "#2F3737"
  },
  "roadWidths": {
    "motorway": 9,
    "trunk": 9,
    "primary": 8,
    "secondary": 7,
    "tertiary": 6,
    "minor": 5,
    "service": 3,
    "path": 1.5
  },
  "casingRatio": 0.25,
  "outlineWidth": 0.8,
